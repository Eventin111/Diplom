FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

ARG REACT_APP_NAME=Swipelt
ARG REACT_APP_API_BASE_URL=
ARG REACT_APP_TRYON_MAX_PROCESSING_SECONDS=600
ARG REACT_APP_USE_MOCK_DATA=false
ARG REACT_APP_MOCK_DELAY_MS=0
ARG REACT_APP_AUTH_INIT_DELAY_MS=300

ENV REACT_APP_NAME=${REACT_APP_NAME}
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_TRYON_MAX_PROCESSING_SECONDS=${REACT_APP_TRYON_MAX_PROCESSING_SECONDS}
ENV REACT_APP_USE_MOCK_DATA=${REACT_APP_USE_MOCK_DATA}
ENV REACT_APP_MOCK_DELAY_MS=${REACT_APP_MOCK_DELAY_MS}
ENV REACT_APP_AUTH_INIT_DELAY_MS=${REACT_APP_AUTH_INIT_DELAY_MS}

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
